# SP-API Credentials (Required)
# Get these from Amazon Developer Console: https://sellercentral.amazon.com/apps/manage
SP_API_CLIENT_ID=your_client_id_here
SP_API_CLIENT_SECRET=your_client_secret_here
SP_API_REFRESH_TOKEN=your_refresh_token_here

# SP-API Configuration
SP_API_BASE_URL=https://sellingpartnerapi-na.amazon.com
# Other regions:
# EU: https://sellingpartnerapi-eu.amazon.com
# FE: https://sellingpartnerapi-fe.amazon.com

# Catalog Path (Required)
# Absolute path to the selling-partner-api-models/models directory
# Example for Windows: C:/Users/yourname/Desktop/SellerBridge/selling-partner-api-models/models
CATALOG_PATH=C:/path/to/selling-partner-api-models/models

# HTTP Bridge Configuration (Optional)
MCP_HTTP_PORT=3001

# Logging (Optional)
LOG_LEVEL=info
# Options: debug, info, warn, error

# OAuth URL (Optional - uses default if not specified)
SP_API_OAUTH_URL=https://api.amazon.com/auth/o2/token

# Response Limits (Optional)
MAX_RESPONSE_TOKENS=25000
